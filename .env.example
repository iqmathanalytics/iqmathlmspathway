# Supabase (required for auth + progress sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_STRIPE_PRICE_LABEL=RM 99 — one-time unlock

# Judge0 code execution (optional)
# When configured, the IDE runs code in Judge0's sandboxed execution system.
# Judge0 supports 60+ languages and can be self-hosted or used through a hosted API.
# Default public CE URL: https://ce.judge0.com
# Self-hosted example URL: http://localhost:2358
# These are NEXT_PUBLIC values because this project is statically exported.
NEXT_PUBLIC_JUDGE0_API_URL=https://ce.judge0.com
NEXT_PUBLIC_JUDGE0_PYTHON_LANGUAGE_ID=109

# Optional public auth headers depending on your Judge0 provider.
# Do not put private production secrets here; use a self-hosted/proxied endpoint for that.
NEXT_PUBLIC_JUDGE0_API_KEY=
NEXT_PUBLIC_JUDGE0_RAPIDAPI_KEY=
NEXT_PUBLIC_JUDGE0_RAPIDAPI_HOST=

# Site URL (used by Supabase Edge Functions for Stripe redirects)
# Set in Supabase Edge Function secrets, not in Next.js:
# SITE_URL=https://your-domain.pages.dev
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
