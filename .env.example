# Supabase (required for auth + progress sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (display label on checkout page)
NEXT_PUBLIC_STRIPE_PRICE_LABEL=RM 99 — one-time unlock

# Site URL (used by Supabase Edge Functions for Stripe redirects)
# Set in Supabase Edge Function secrets, not in Next.js:
# SITE_URL=https://your-domain.pages.dev
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
