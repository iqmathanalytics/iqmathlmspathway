# Cloudflare Pages headers (copied into out/ on Next export).
# Keep HTML fresh so chunk hashes always match the latest deploy.
# Hashed /_next/static assets can be cached forever.

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/dashboard
  Cache-Control: public, max-age=0, must-revalidate

/dashboard/
  Cache-Control: public, max-age=0, must-revalidate

/learn/*
  Cache-Control: public, max-age=0, must-revalidate

/practice/*
  Cache-Control: public, max-age=0, must-revalidate

/auth/*
  Cache-Control: public, max-age=0, must-revalidate

/checkout/*
  Cache-Control: public, max-age=0, must-revalidate

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
